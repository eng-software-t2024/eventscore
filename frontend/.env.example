# URL pública do Supabase Auth/API do EventScore (valor público)
VITE_SUPABASE_URL=https://supabase-eventscore.olua.me
VITE_SUPABASE_PUBLISHABLE_KEY=

# Em produção, use /api/v1 para same-origin atrás do proxy.
VITE_API_BASE_URL=/api/v1

# Desenvolvimento local (não usado no build de produção)
VITE_DEV_API_TARGET=http://127.0.0.1:13000
VITE_DEV_SUPABASE_TARGET=https://supabase-eventscore.olua.me
