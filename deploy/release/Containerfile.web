ARG NODE_IMAGE=node:24-bookworm-slim@sha256:0e2646ab57e77b7a384a0cb59b6815b182c77e1f9c3ba36bd8435bd9c4e6680e
ARG NGINX_IMAGE=nginx:1.28.3-alpine@sha256:0dcc88822d45581e65ae329f8be769762bf628d3b2bb7d2a077d4aa5c98b30e3

FROM ${NODE_IMAGE} AS web-build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ARG VCS_REF
RUN env -u API_URL npm run build

FROM ${NGINX_IMAGE} AS runtime
COPY deploy/release/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /app/web/dist/ /usr/share/nginx/html/
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/hanrrysantos/event-score" \
      org.opencontainers.image.revision="${VCS_REF}"
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
